generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (from CRM) ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // FirstCrop additions
  employeeId    String?   @unique
  department    String?   // PRODUCTION, QC, SALES, LOGISTICS, FINANCE, ADMIN
  plant         String?   // Which manufacturing plant
  shift         String?   // MORNING, AFTERNOON, NIGHT
  designation   String?
  aadhaarNumber String?
  joiningDate   DateTime?

  accounts      Account[]
  sessions      Session[]
  activities    Activity[]
  agentConversations AgentConversation[]
  assignedTasks AgentTask[]          @relation("AssignedTasks")
  createdTasks  AgentTask[]          @relation("CreatedTasks")
  ownerships    PartyOwnership[]
  salesOrders   SalesOrder[]         @relation("SalesOrderCreator")
  fieldVisits   FieldVisit[]
  qcTests       QCTest[]             @relation("QCTester")
  members       Member[]
  invitations   Invitation[]         @relation("InvitedByUser")
  distributors  Distributor[]

  @@index([email])
  @@index([phone])
  @@index([department])
}

model Session {
  id          String   @id
  expiresAt   DateTime
  token       String   @unique
  ipAddress   String?
  userAgent   String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id
  accountId         String
  providerId        String
  userId            String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ─── Organization Models ─────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Member[]
  invitations Invitation[]
  activities  Activity[]
  agents      AgentConversation[]
  settings    AppSetting[]
  companies   Party[]
  salesOrders SalesOrder[]
  batches     Batch[]
  purchaseOrders PurchaseOrder[]
  shipments   Shipment[]
  complianceRecords ComplianceRecord[]
  invoices    Invoice[]
  agentTasks   AgentTask[]

  @@index([slug])
}

model Member {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  role            String   @default("member") // owner, admin, plant_manager, qc_manager, sales_manager, field_agent, accountant, viewer
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id              String   @id @default(cuid())
  organizationId  String
  email           String
  role            String   @default("member")
  status          String   @default("pending") // pending, accepted, expired
  token           String   @unique
  expiresAt       DateTime
  invitedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("InvitedByUser", fields: [invitedById], references: [id])

  @@unique([organizationId, email])
  @@index([token])
}

// ─── Party Models (Customers, Distributors, Vendors, etc.) ──────────────────

model Party {
  id              String   @id @default(cuid())
  organizationId  String
  type            String   // CUSTOMER, DISTRIBUTOR, RETAILER, VENDOR, FARM, COOPERATIVE, GOVT_AGENCY
  name            String
  displayName     String?
  legalName       String?
  gstin           String?
  panNumber       String?
  fssaiNumber     String?
  state           String?
  district        String?
  city            String?
  pincode         String?
  addressLine1    String?
  addressLine2    String?
  website         String?
  notes           String?
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  activities      Activity[]
  ownerships      PartyOwnership[]
  salesOrders     SalesOrder[]
  purchaseOrders  PurchaseOrder[]
  deliveries      Delivery[]
  fieldVisits     FieldVisit[]
  vendorAccounts  VendorAccount[]
  invoicesAsVendor Invoice[]     @relation("InvoiceVendor")
  invoicesAsCustomer Invoice[]   @relation("InvoiceCustomer")
  complianceRecords ComplianceRecord[]
  distributor     Distributor?

  @@index([organizationId, type])
  @@index([gstin])
  @@index([fssaiNumber])
}

model Contact {
  id              String   @id @default(cuid())
  partyId         String
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  designation     String?
  department      String?
  isPrimary       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  activities      Activity[]

  @@index([partyId])
  @@index([email])
  @@index([phone])
}

model PartyOwnership {
  id              String   @id @default(cuid())
  partyId         String
  userId          String
  role            String   @default("owner") // owner, manager, field_agent
  assignedAt      DateTime @default(now())

  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
}

// ─── Product Catalog ────────────────────────────────────────────────────────

model Product {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  sku             String   @unique
  category        String   // BIO_FERTILIZER, BIO_PESTICIDE, BIO_FUNGICIDE, BIO_INSECTICIDE, ORGANIC_FERTILIZER, PLANT_GROWTH_REGULATOR, SOIL_CONDITIONER, SEED_TREATMENT
  description     String?
  shortDescription String?

  // Microbial specifics
  strainName      String?
  strainId        String?   // Culture collection ID
  formulationType String?   // LIQUID, POWDER, GRANULE, TABLET, SUSPENSION
  cfuPerGram      Decimal?  @db.Decimal(12, 2)  // Colony Forming Units per gram
  cfuPerMl        Decimal?  @db.Decimal(12, 2)  // Colony Forming Units per ml
  phRange         String?   // e.g., "6.0-7.5"
  temperatureRange String?  // e.g., "25-35°C"

  // Packaging
  unitSize        Decimal?  @db.Decimal(10, 2)  // e.g., 500
  unitSizeUnit    String?   // GRAM, ML, KG, LITER
  unitsPerPack    Int?
  packType        String?   // BOTTLE, POUCH, BAG, BOX

  // Pricing
  mrpPerUnit      Decimal?  @db.Decimal(10, 2)
  costPerUnit     Decimal?  @db.Decimal(10, 2)
  gstRate         Decimal?  @db.Decimal(5, 2)  // e.g., 12.00

  // Shelf life
  shelfLifeDays   Int?
  storageTempMin  Decimal?  @db.Decimal(5, 2)  // °C
  storageTempMax  Decimal?  @db.Decimal(5, 2)

  // Compliance
  fssaiNumber     String?
  bisNumber       String?
  organicCertified Boolean  @default(false)
  registrationNumber String?

  // Status
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  batches         Batch[]
  orderItems      SalesOrderItem[]
  inventory       Inventory[]
  inventoryMovements InventoryMovement[]

  @@index([organizationId, category])
  @@index([sku])
  @@index([strainName])
}

// ─── Raw Materials ──────────────────────────────────────────────────────────

model RawMaterial {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  code            String   @unique
  category        String   // STRAIN, MEDIA, PACKAGING, CHEMICAL, LABEL
  description     String?

  // Strain specifics (if category = STRAIN)
  strainName      String?
  cultureCollection String?
  strainType      String?  // BACTERIA, FUNGUS, ALGAE

  // Stock
  currentStock    Decimal  @default(0) @db.Decimal(12, 2)
  unit            String   // GRAM, ML, KG, LITER, PIECE
  reorderLevel    Decimal  @db.Decimal(12, 2)
  reorderQuantity Decimal  @db.Decimal(12, 2)
  maxStock        Decimal? @db.Decimal(12, 2)

  // Cost
  costPerUnit     Decimal? @db.Decimal(10, 2)

  // Storage
  storageCondition String?  // ROOM_TEMP, COLD_STORAGE, FREEZER
  minTemp         Decimal? @db.Decimal(5, 2)
  maxTemp         Decimal? @db.Decimal(5, 2)

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batchIngredients BatchIngredient[]
  inventory        Inventory[]
  purchaseOrderItems PurchaseOrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([organizationId, category])
  @@index([code])
}

// ─── Batch / Production ─────────────────────────────────────────────────────

model Batch {
  id              String   @id @default(cuid())
  organizationId  String
  batchNumber     String   @unique
  productId       String
  status          String   @default("PLANNED") // PLANNED, IN_PROGRESS, FERMENTATION, PROCESSING, QC_PENDING, QC_PASSED, QC_REJECTED, PACKAGING, READY_FOR_DISPATCH, DISPATCHED, EXPIRED, CANCELLED

  // Production details
  plannedQuantity Decimal  @db.Decimal(12, 2)
  actualQuantity  Decimal? @db.Decimal(12, 2)
  unit            String   // GRAM, ML, KG, LITER
  yieldPercentage Decimal? @db.Decimal(5, 2)

  // Fermentation
  fermenterId     String?
  fermenterCapacity Decimal? @db.Decimal(10, 2)
  incubationTemp  Decimal? @db.Decimal(5, 2)  // °C
  incubationPH    Decimal? @db.Decimal(5, 2)
  incubationTimeHours Int?
  agitationRPM    Int?

  // Processing
  processingMethod String?  // CENTRIFUGE, FILTRATION, DRYING, BLENDING
  processingDate  DateTime?

  // Packaging
  packagingDate   DateTime?
  packagingType   String?
  unitsProduced   Int?

  // Dates
  plannedStartDate DateTime?
  actualStartDate  DateTime?
  plannedEndDate   DateTime?
  actualEndDate    DateTime?

  // QC
  qcStatus        String?  // PENDING, PASS, FAIL, CONDITIONAL_PASS
  qcDate          DateTime?
  certificateNumber String?

  // Expiry
  expiryDate      DateTime
  shelfLifeDays   Int?

  // Cost
  totalCost       Decimal? @db.Decimal(12, 2)
  costPerUnit     Decimal? @db.Decimal(10, 2)

  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  ingredients     BatchIngredient[]
  qcTests         QCTest[]
  orderItems      SalesOrderItem[]
  discussions     BatchDiscussion[]

  @@index([organizationId, status])
  @@index([batchNumber])
  @@index([productId])
  @@index([expiryDate])
}

model BatchIngredient {
  id              String   @id @default(cuid())
  batchId         String
  rawMaterialId   String
  plannedQuantity Decimal  @db.Decimal(12, 2)
  actualQuantity  Decimal? @db.Decimal(12, 2)
  unit            String
  addedAt         DateTime @default(now())

  batch           Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rawMaterial     RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([batchId])
}

model BatchDiscussion {
  id              String   @id @default(cuid())
  batchId         String
  userId          String?
  message         String
  createdAt       DateTime @default(now())

  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

// ─── Quality Control ────────────────────────────────────────────────────────

model QCTest {
  id              String   @id @default(cuid())
  batchId         String
  testType        String   // CFU_COUNT, PH_LEVEL, MOISTURE, CONTAMINATION, VISCOSITY, COLOR, ODOR, SPECIFIC_GRAVITY, HEAVY_METALS, PATHOGEN_TEST
  testMethod      String?  // PLATE_COUNT, SPECTROSCOPY, TITRATION, etc.
  parameter       String   // What was tested
  expectedValue   String?  // Expected result
  actualValue     String?  // Actual measured value
  unit            String?
  result          String?  // PASS, FAIL, CONDITIONAL_PASS, INCONCLUSIVE
  notes           String?
  testedById      String?
  testedAt        DateTime @default(now())
  certificateNumber String?
  labName         String?

  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tester          User?    @relation("QCTester", fields: [testedById], references: [id])

  @@index([batchId])
  @@index([testType])
}

// ─── Inventory ──────────────────────────────────────────────────────────────

model InventoryLocation {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  type            String   // WAREHOUSE, COLD_STORAGE, PRODUCTION_FLOOR, QC_LAB, FINISHED_GOODS, DISPATCH_CENTER
  address         String?
  capacity        Decimal? @db.Decimal(12, 2)
  temperatureControlled Boolean @default(false)
  minTemp         Decimal? @db.Decimal(5, 2)
  maxTemp         Decimal? @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventory       Inventory[]
  fromMovements   InventoryMovement[] @relation("FromLocation")
  toMovements     InventoryMovement[] @relation("ToLocation")

  @@index([organizationId, type])
}

model Inventory {
  id              String   @id @default(cuid())
  organizationId  String
  locationId      String
  productId       String?
  rawMaterialId   String?
  batchNumber     String?
  quantity        Decimal  @default(0) @db.Decimal(12, 2)
  unit            String
  expiryDate      DateTime?
  lastUpdated     DateTime @default(now())

  location        InventoryLocation @relation(fields: [locationId], references: [id])
  product         Product? @relation(fields: [productId], references: [id])
  rawMaterial     RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  @@index([organizationId, locationId])
  @@index([productId])
  @@index([rawMaterialId])
  @@index([batchNumber])
  @@index([expiryDate])
}

model InventoryMovement {
  id              String   @id @default(cuid())
  organizationId  String
  type            String   // RECEIPT, PRODUCTION_OUTPUT, DISPATCH, EXPIRY_WRITE_OFF, TRANSFER, ADJUSTMENT, DAMAGE
  productId       String?
  rawMaterialId   String?
  batchNumber     String?
  fromLocationId  String?
  toLocationId    String?
  quantity        Decimal  @db.Decimal(12, 2)
  unit            String
  referenceType   String?  // PURCHASE_ORDER, SALES_ORDER, BATCH, MANUAL
  referenceId     String?
  notes           String?
  performedById   String?
  performedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  product         Product? @relation(fields: [productId], references: [id])
  rawMaterial     RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  fromLocation    InventoryLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation      InventoryLocation? @relation("ToLocation", fields: [toLocationId], references: [id])

  @@index([organizationId, type])
  @@index([productId])
  @@index([rawMaterialId])
  @@index([performedAt])
}

// ─── Sales & Orders ────────────────────────────────────────────────────────

model SalesOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  organizationId  String
  customerId      String
  orderType       String   @default("DISTRIBUTOR") // DISTRIBUTOR, DIRECT, GOVERNMENT, EXPORT
  status          String   @default("PLACED") // PLACED, CONFIRMED, IN_PRODUCTION, READY_FOR_DISPATCH, PARTIALLY_SHIPPED, FULLY_SHIPPED, DELIVERED, RETURNED, CANCELLED
  priority        String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // Dates
  orderDate       DateTime @default(now())
  requiredByDate  DateTime?
  confirmedAt     DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  // Financial
  subtotal        Decimal  @db.Decimal(12, 2)
  gstAmount       Decimal  @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  shippingCharges Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  paymentStatus   String   @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE, REFUNDED

  // Shipping
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?

  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  customer        Party     @relation(fields: [customerId], references: [id])
  creator         User?     @relation("SalesOrderCreator", fields: [createdById], references: [id])
  items           SalesOrderItem[]
  shipments       Shipment[]
  invoice         Invoice?
  delivery        Delivery?

  @@index([organizationId, status])
  @@index([orderNumber])
  @@index([customerId])
  @@index([orderDate])
}

model SalesOrderItem {
  id              String   @id @default(cuid())
  salesOrderId    String
  productId       String
  batchId         String?
  quantity        Decimal  @db.Decimal(12, 2)
  unit            String
  unitPrice       Decimal  @db.Decimal(10, 2)
  discount        Decimal  @default(0) @db.Decimal(10, 2)
  gstRate         Decimal  @db.Decimal(5, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  dispatchedQuantity Decimal @default(0) @db.Decimal(12, 2)
  notes           String?

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id])
  batch           Batch?     @relation(fields: [batchId], references: [id])

  @@index([salesOrderId])
}

// ─── Procurement ────────────────────────────────────────────────────────────

model VendorAccount {
  id              String   @id @default(cuid())
  partyId         String
  accountNumber   String?
  bankName        String?
  ifscCode        String?
  upiId           String?
  paymentTerms    String?  // NET_30, NET_60, ADVANCE, COD
  creditLimit     Decimal? @db.Decimal(12, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([partyId])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique
  organizationId  String
  vendorId        String
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, CONFIRMED, PARTIALLY_RECEIVED, FULLY_RECEIVED, CANCELLED

  orderDate       DateTime @default(now())
  expectedDate    DateTime?
  receivedDate    DateTime?

  subtotal        Decimal  @db.Decimal(12, 2)
  gstAmount       Decimal  @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  paymentStatus   String   @default("PENDING") // PENDING, PARTIAL, PAID

  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  vendor          Party     @relation(fields: [vendorId], references: [id])
  items           PurchaseOrderItem[]

  @@index([organizationId, status])
  @@index([poNumber])
  @@index([vendorId])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  rawMaterialId   String
  quantity        Decimal  @db.Decimal(12, 2)
  unit            String
  unitPrice       Decimal  @db.Decimal(10, 2)
  gstRate         Decimal  @db.Decimal(5, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  receivedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  notes           String?

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  @@index([purchaseOrderId])
}

// ─── Distribution & Logistics ───────────────────────────────────────────────

model Distributor {
  id              String   @id @default(cuid())
  partyId         String   @unique
  territory       String
  region          String?
  state           String?
  district        String?
  targetQuantity  Decimal? @db.Decimal(12, 2)
  currentQuantity Decimal  @default(0) @db.Decimal(12, 2)
  commissionRate  Decimal? @db.Decimal(5, 2)
  coldStorageAvail Boolean @default(false)
  fieldAgentId    String?
  rating          Decimal? @db.Decimal(3, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  party           Party    @relation(fields: [partyId], references: [id])
  fieldAgent      User?    @relation(fields: [fieldAgentId], references: [id])
  deliveries      Delivery[]

  @@index([territory])
}

model Delivery {
  id              String   @id @default(cuid())
  deliveryNumber  String   @unique
  salesOrderId    String?  @unique
  distributorId   String?
  customerId      String?
  status          String   @default("PENDING") // PENDING, IN_TRANSIT, DELIVERED, FAILED, RETURNED

  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPincode String?

  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  deliveredAt     DateTime?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesOrder      SalesOrder? @relation(fields: [salesOrderId], references: [id])
  distributor     Distributor? @relation(fields: [distributorId], references: [id])
  customer        Party?      @relation(fields: [customerId], references: [id])
  shipment        Shipment?

  @@index([status])
  @@index([deliveryNumber])
}

model Vehicle {
  id              String   @id @default(cuid())
  registrationNumber String @unique
  type            String   // TRUCK, VAN, TEMPO, BIKE, COLD_CHAIN_VEHICLE
  capacity        Decimal? @db.Decimal(10, 2)
  capacityUnit    String?  // KG, LITER, PIECE
  hasColdChain    Boolean  @default(false)
  minTemp         Decimal? @db.Decimal(5, 2)
  maxTemp         Decimal? @db.Decimal(5, 2)
  gpsTrackingId   String?
  driverName      String?
  driverPhone     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shipments       Shipment[]

  @@index([registrationNumber])
}

model Shipment {
  id              String   @id @default(cuid())
  shipmentNumber  String   @unique
  organizationId  String
  salesOrderId    String?
  deliveryId      String?   @unique
  vehicleId       String?
  status          String   @default("PREPARING") // PREPARING, LOADED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED

  dispatchedAt    DateTime?
  estimatedArrival DateTime?
  actualArrival   DateTime?
  deliveredAt     DateTime?

  temperatureLog  Json?    // Array of { timestamp, temperature }
  gpsLog          Json?    // Array of { timestamp, lat, lng }

  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  salesOrder      SalesOrder? @relation(fields: [salesOrderId], references: [id])
  delivery        Delivery?   @relation(fields: [deliveryId], references: [id])
  vehicle         Vehicle?    @relation(fields: [vehicleId], references: [id])

  @@index([organizationId, status])
  @@index([shipmentNumber])
}

// ─── Compliance ─────────────────────────────────────────────────────────────

model ComplianceRecord {
  id              String   @id @default(cuid())
  organizationId  String
  partyId         String?
  productId       String?
  certType        String   // FSSAI, ORGANIC, BIS, ISO, GST_REGISTRATION, TRADE_LICENSE, MSME
  certificateNumber String
  issuedBy        String?
  issuedDate      DateTime
  expiryDate      DateTime
  status          String   @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED, REVOKED
  documentUrl     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  party           Party?       @relation(fields: [partyId], references: [id])

  @@index([organizationId, certType])
  @@index([expiryDate])
}

// ─── Finance ────────────────────────────────────────────────────────────────

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  organizationId  String
  salesOrderId    String?   @unique
  purchaseOrderId String?
  vendorId        String?
  customerId      String?
  type            String   // SALES, PURCHASE, CREDIT_NOTE, DEBIT_NOTE
  status          String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED

  invoiceDate     DateTime @default(now())
  dueDate         DateTime?
  paidDate        DateTime?

  subtotal        Decimal  @db.Decimal(12, 2)
  cgstAmount      Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal  @default(0) @db.Decimal(12, 2)
  totalTax        Decimal  @default(0) @db.Decimal(12, 2)
  tdsAmount       Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(12, 2)

  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  salesOrder      SalesOrder? @relation(fields: [salesOrderId], references: [id])
  vendor          Party?      @relation("InvoiceVendor", fields: [vendorId], references: [id])
  customer        Party?      @relation("InvoiceCustomer", fields: [customerId], references: [id])
  payments        Payment[]

  @@index([organizationId, type, status])
  @@index([invoiceNumber])
}

model Payment {
  id              String   @id @default(cuid())
  paymentNumber   String   @unique
  invoiceId       String
  vendorAccountId String?
  amount          Decimal  @db.Decimal(12, 2)
  method          String   // BANK_TRANSFER, UPI, CASH, CHEQUE, NEFT, RTGS
  referenceNumber String?
  notes           String?
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  vendorAccount   VendorAccount? @relation(fields: [vendorAccountId], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}

// ─── Field Service ──────────────────────────────────────────────────────────

model FieldVisit {
  id              String   @id @default(cuid())
  partyId         String
  visitedById     String
  visitType       String   // CROP_ADVISORY, PEST_DIAGNOSIS, SOIL_TEST, PRODUCT_DEMO, COMPLAINT, FOLLOW_UP
  status          String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  scheduledDate   DateTime
  completedDate   DateTime?
  location        String?
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  notes           String?
  findings        String?
  recommendations String?
  photos          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  party           Party    @relation(fields: [partyId], references: [id])
  visitor         User     @relation(fields: [visitedById], references: [id])

  @@index([visitedById])
  @@index([scheduledDate])
  @@index([visitType])
}

// ─── Activity Timeline ──────────────────────────────────────────────────────

model Activity {
  id              String   @id @default(cuid())
  organizationId  String?
  entityType      String   // PARTY, CONTACT, BATCH, ORDER, INVOICE, etc.
  entityId        String
  type            String   // NOTE, CALL, EMAIL, MEETING, TASK, STAGE_CHANGE, QC_TEST, QC_APPROVAL, etc.
  title           String
  description     String?
  metadata        Json?
  performedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?

  contact         Contact?      @relation(fields: [contactId], references: [id])
  contactId       String?

  party           Party?        @relation(fields: [partyId], references: [id])
  partyId         String?

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([performedAt])
}

// ─── Agent ──────────────────────────────────────────────────────────────────

model AgentConversation {
  id              String   @id @default(cuid())
  organizationId  String
  entityType      String?  // BATCH, ORDER, PRODUCT, etc.
  entityId        String?
  title           String?
  status          String   @default("active") // active, archived
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  messages        AgentMessage[]

  @@index([organizationId])
  @@index([entityType, entityId])
}

model AgentMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String   // user, assistant, system
  content         String
  metadata        Json?
  createdAt       DateTime @default(now())

  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AgentTask {
  id              String   @id @default(cuid())
  organizationId  String
  kind            String   // QC_TEST_SCHEDULED, EXPIRY_ALERT, REORDER_RAW_MATERIAL, COMPLIANCE_CHECK, PRODUCTION_REVIEW, DISPATCH_REMINDER
  entityType      String?  // BATCH, ORDER, PRODUCT, RAW_MATERIAL, etc.
  entityId        String?
  title           String
  description     String?
  priority        String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED, CANCELLED
  scheduledFor    DateTime?
  completedAt     DateTime?
  createdById     String?
  assignedToId    String?
  result          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  creator         User?        @relation("CreatedTasks", fields: [createdById], references: [id])
  assignee        User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([organizationId, status])
  @@index([kind])
  @@index([scheduledFor])
  @@index([entityType, entityId])
}

// ─── Settings ───────────────────────────────────────────────────────────────

model AppSetting {
  id              String   @id @default(cuid())
  organizationId  String
  key             String
  value           Json
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

// ─── Suppression / Exclusion ────────────────────────────────────────────────

model SuppressedDomain {
  id              String   @id @default(cuid())
  domain          String   @unique
  reason          String?
  createdAt       DateTime @default(now())
}

model SuppressedContact {
  id              String   @id @default(cuid())
  contactId       String   @unique
  reason          String?
  suppressedAt    DateTime @default(now())
}

// ─── Contact Facts (Evidence Scored) ────────────────────────────────────────

model ContactFact {
  id              String   @id @default(cuid())
  contactId       String
  factType        String   // CFU_COUNT, QC_RESULT, BATCH_INFO, DELIVERY_STATUS, etc.
  factValue       Json
  confidence      Decimal  @db.Decimal(3, 2) // 0.00 to 1.00
  source          String   // lab.test-certificate, vendor.invoice-match, etc.
  sourcedAt       DateTime @default(now())
  expiresAt       DateTime?
  supersededById  String?
  createdAt       DateTime @default(now())

  @@index([contactId, factType])
  @@index([expiresAt])
}

model ContactBrief {
  id              String   @id @default(cuid())
  contactId       String   @unique
  briefMarkdown   String   @db.Text
  generatedAt     DateTime @default(now())
  expiresAt       DateTime?
  version         Int      @default(1)

  @@index([contactId])
}

model CompanyEnrichment {
  id              String   @id @default(cuid())
  partyId         String   @unique
  source          String   // fssai.verify, gst.portal, trade.directory
  data            Json
  generatedAt     DateTime @default(now())
  expiresAt       DateTime?
  version         Int      @default(1)

  @@index([partyId])
}
