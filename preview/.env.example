# Supabase (optional) — leave unset to fall back to local JSON data.
# Content editors manage data in Supabase Studio; the Astro build fetches
# at build time when these are set.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Seed script only (never commit real keys):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
