---
// Offers — coupon cards with copy chips, plus a link to the seasonal deals
// context. Uses CouponChip so the copy affordance matches the cart page.
import StoreLayout from '@shared/layouts/StoreLayout.astro';
import Icon from '@ui/Icon.astro';
import Card from '@ui/Card.astro';
import CardBody from '@ui/CardBody.astro';
import Badge from '@ui/Badge.astro';
import CouponChip from '@shared/components/storefront/CouponChip.astro';
import { getCollection } from '@shared/lib/storefront-data';
import type { Offer } from '@shared/lib/storefront-data';

const offers = await getCollection<Offer>('offers');
const featured = offers.filter((o) => o.featured);
const rest = offers.filter((o) => !o.featured);

const couponLabel = (o: { type: string; value: number; minBasket: number }) => {
	if (o.type === 'percent') return `${o.value}% off above ₹${o.minBasket.toLocaleString('en-IN')}`;
	if (o.type === 'fixed') return `₹${o.value} off above ₹${o.minBasket.toLocaleString('en-IN')}`;
	return 'Free delivery above ₹' + o.minBasket.toLocaleString('en-IN');
};

---

<StoreLayout title="Offers" currentNav="offers">
	<div class="mb-4">
		<h1 class="h2 mb-1">Seasonal offers</h1>
		<p class="text-secondary mb-0">Copy a coupon code and apply it at checkout. Valid till the date shown on each card.</p>
	</div>

	{featured.length > 0 && (
		<div class="row g-3 mb-4">
			{featured.map((offer) => (
				<div class="col-md-6">
					<Card class="store-offer h-100">
						<CardBody>
							<div class="d-flex align-items-center gap-3">
								<div class="store-offer-icon"><Icon name={offer.icon} /></div>
								<div class="d-flex align-items-center gap-2">
									<h3 class="h5 mb-0">{offer.title}</h3>
									{offer.featured && <Badge color="green" light>Featured</Badge>}
								</div>
								<p class="text-secondary small mb-2">{offer.description}</p>
							</div>
							<div class="d-flex flex-wrap align-items-center gap-2 mt-2">
								<CouponChip code={offer.code} label={couponLabel(offer)} />
								<span class="text-secondary small ms-auto">Valid till {offer.validUntil}</span>
							</div>
						</CardBody>
					</Card>
				</div>
			))}
		</div>
	)}

	{rest.length > 0 && (
		<div class="row g-3 mb-4">
			{rest.map((offer) => (
				<div class="col-md-6 col-lg-4">
					<Card class="store-offer h-100">
						<CardBody>
							<div class="d-flex align-items-center gap-3">
								<div class="store-offer-icon"><Icon name={offer.icon} /></div>
								<div>
									<h3 class="h6 mb-0">{offer.title}</h3>
									<p class="text-secondary small mb-0">{offer.description}</p>
								</div>
							</div>
							<div class="mt-2">
								<CouponChip code={offer.code} label={couponLabel(offer)} />
							</div>
							<div class="text-secondary small mt-2">Valid till {offer.validUntil}</div>
						</CardBody>
					</Card>
				</div>
			))}
		</div>
	)}

	<div class="alert alert-soft alert-green" role="alert">
		<div class="d-flex align-items-center gap-2">
			<Icon name="info-circle" />
			<span>Offers apply to eligible products only and cannot be combined. Subsidised items (DAP, urea) may be excluded.</span>
		</div>
	</div>
</StoreLayout>