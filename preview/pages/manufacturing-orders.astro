---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro';
import EcommerceStats from '@shared/components/cards/EcommerceStats.astro';
import Card from '@ui/Card.astro';
import CardHeader from '@ui/CardHeader.astro';
import CardBody from '@ui/CardBody.astro';
import Chart from '@ui/Chart.astro';
import Badge from '@ui/Badge.astro';
import Progress from '@ui/Progress.astro';
import { fetchOrders, fetchOrderStats, fetchCustomers } from '@shared/lib/fetchers';
import ordersFallback from '@data/manufacturing-orders.json';

// Fetch live data from API; fall back to JSON
const [apiOrders, orderStats, customers] = await Promise.all([
  fetchOrders(),
  fetchOrderStats(),
  fetchCustomers(),
]);

const ordersData = ordersFallback as any;

// Use live customers data when available, fall back to JSON
const topCustomers = customers.length > 0
  ? customers
      .sort((a: any, b: any) => (b.revenue ?? 0) - (a.revenue ?? 0))
      .slice(0, 5)
      .map((c: any) => ({
        name: c.displayName || c.name,
        orders: c.orderCount,
        revenue: c.revenue ? `₹${(Number(c.revenue) / 100000).toFixed(0)}L` : '—',
        avgLead: '—',
        segment: 'Customer',
        segmentColor: 'blue',
      }))
  : ordersData.topCustomers;
---

<DefaultLayout
	title="Sales Orders"
	pageHeader="Sales Orders"
	description="Manage distributor, direct, government, and export orders"
	pageMenu="manufacturing.orders"
	pageLibs={['apexcharts']}
>
	<div class="row row-cards">
		<div class="col-12">
			<div class="row row-cards">
				{
					(ordersData as { kpis: { title: string; value: string; change: string; up: boolean; color: string; icon: string }[] }).kpis.map((kpi) => (
						<div class="col-sm-6 col-lg-3">
							<EcommerceStats color={kpi.color} icon={kpi.icon} title={kpi.title} description={kpi.value} change={kpi.change} up={kpi.up} />
						</div>
					))
				}
			</div>
		</div>

		<div class="col-12">
			<div class="row row-cards">
				<div class="col-12 col-lg-8">
					<Card>
						<CardHeader>
							<div class="card-title">Order pipeline</div>
							<div class="card-subtitle">Orders by status, value ₹L</div>
						</CardHeader>
						<CardBody>
							<Chart chartId="mfg-orders-pipeline" height={16} />
						</CardBody>
					</Card>
				</div>
				<div class="col-12 col-lg-4">
					<Card>
						<CardHeader>
							<div class="card-title">By order type</div>
							<div class="card-subtitle">Revenue share</div>
						</CardHeader>
						<CardBody>
							<Chart chartId="mfg-orders-type" height={16} />
						</CardBody>
					</Card>
				</div>
			</div>
		</div>

		<div class="col-12">
			<div class="row row-cards">
				<div class="col-12">
					<Card>
						<CardHeader>
							<div class="card-title">Recent orders</div>
							<div class="card-subtitle">Latest sales activity</div>
						</CardHeader>
						<div class="table-responsive">
							<table class="table card-table table-vcenter">
								<thead>
									<tr>
										<th>Order</th>
										<th>Customer</th>
										<th>Type</th>
										<th class="text-end">Items</th>
										<th class="text-end">Total</th>
										<th>Status</th>
									</tr>
								</thead>
								<tbody>
									{
										(ordersData as { recentOrders: { order: string; customer: string; type: string; items: number; total: string; status: string; statusColor: string; date: string }[] }).recentOrders.map(
											(o) => (
												<tr>
													<td>
														<div class="fw-medium">{o.order}</div>
														<div class="text-secondary">{o.date}</div>
													</td>
													<td>{o.customer}</td>
													<td><Badge color="blue" light>{o.type}</Badge></td>
													<td class="text-end">{o.items}</td>
													<td class="text-end fw-medium">{o.total}</td>
													<td><Badge color={o.statusColor} light>{o.status}</Badge></td>
												</tr>
											)
										)
									}
								</tbody>
							</table>
						</div>
					</Card>
				</div>
			</div>
		</div>

		<div class="col-12">
			<div class="row row-cards">
				<div class="col-12 col-lg-6">
					<Card>
						<CardHeader>
							<div class="card-title">Top customers</div>
							<div class="card-subtitle">By revenue</div>
						</CardHeader>
						<div class="table-responsive">
							<table class="table card-table table-vcenter">
								<thead>
									<tr>
										<th>Customer</th>
										<th class="text-end">Orders</th>
										<th class="text-end">Revenue</th>
										<th>Segment</th>
									</tr>
								</thead>
								<tbody>
									{
										(topCustomers as { name: string; orders: number; revenue: string; avgLead: string; segment: string; segmentColor: string }[]).map(
											(c) => (
												<tr>
													<td class="fw-medium">{c.name}</td>
													<td class="text-end">{c.orders}</td>
													<td class="text-end">{c.revenue}</td>
													<td><Badge color={c.segmentColor} light>{c.segment}</Badge></td>
												</tr>
											)
										)
									}
								</tbody>
							</table>
						</div>
					</Card>
				</div>
				<div class="col-12 col-lg-6">
					<Card>
						<CardHeader>
							<div class="card-title">Monthly trend</div>
							<div class="card-subtitle">Orders & revenue, 6 months</div>
						</CardHeader>
						<CardBody>
							<Chart chartId="mfg-orders-trend" height={16} />
						</CardBody>
					</Card>
				</div>
			</div>
		</div>
	</div>
</DefaultLayout>
