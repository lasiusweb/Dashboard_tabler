---
// Reusable firstcrop.in ecommerce KPI card: icon avatar + title + value + optional
// sparkline (chartData CSV) + optional delta text with up/down colour.
import Icon from '@ui/Icon.astro';
import ChartSparkline from '@ui/ChartSparkline.astro';

interface Props {
	color?: string;
	icon?: string;
	lt?: boolean;
	title?: string;
	description?: string;
	/** comma-separated numeric series for the right-side sparkline */
	chartData?: string;
	chartType?: string;
	/** delta text, e.g. "+12.4%" — green when up, red when down */
	change?: string;
	/** if false, the change value renders red */
	up?: boolean;
	/** text shown after the change (e.g. " vs last month") */
	changeUnit?: string;
	class?: string;
}

const {
	color = 'primary',
	icon,
	lt = true,
	title,
	description,
	chartData,
	chartType = 'area',
	change,
	up = true,
	changeUnit,
	class: className,
} = Astro.props;

const avatarClass = [color ? `bg-${color}${lt ? '-lt' : ' text-white'}` : '', 'avatar', 'avatar-square'];
const changeColor = change ? (up ? 'text-green' : 'text-red') : '';
---

<div class:list={['card card-sm', className]}>
	<div class="card-body p-3">
		<div class="row align-items-center">
			{
				icon && (
					<div class="col-auto">
						<span class:list={avatarClass}><Icon name={icon} /></span>
					</div>
				)
			}

			<div class="col">
				<div class="text-secondary text-uppercase fw-normal small">{title}</div>
				<div class="h3 m-0">{description}</div>
				<div class="mt-1">
					<span class={`fw-medium ${changeColor}`}>{change}</span>
					{changeUnit && <span class="text-secondary ms-1">{changeUnit}</span>}
				</div>
			</div>

			{
				chartData && (
					<div class="col-auto d-none d-xl-block">
						<ChartSparkline id={`spark-${title?.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} data={chartData} type={chartType} color={color} wide />
					</div>
				)
			}
		</div>
	</div>
</div>
