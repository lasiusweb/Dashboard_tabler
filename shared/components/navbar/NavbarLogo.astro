---
// TODO: unported Liquid params: prefix (the "sidebar-brand" variant, used only
// in layouts with a sidebar), breakpoint (assigned in Liquid but unused in the
// markup), href ("/{href}" appended to page|relative — no ported page passes
// it).
import { site } from '@shared/lib/site';

interface Props {
	href?: string;
	class?: string;
	/** wraps the logo in <div class="navbar-brand ..."><a>...</a></div> (header=true param) */
	header?: boolean;
	smallLogo?: boolean;
	hideLogo?: boolean;
	showTitle?: boolean;
}

const {
	href = '.',
	class: className,
	header = false,
	smallLogo = false,
	hideLogo = false,
	showTitle = false,
} = Astro.props;

const brandClasses = ['navbar-brand navbar-brand-autodark', className];
const logoClass = `navbar-brand-image${showTitle ? ' me-3' : ''}`;

const logoMark =
	'<rect x="2" y="2" width="28" height="28" rx="8" fill="var(--fc-primary, #2fb344)" /><rect x="9" y="7" width="4.5" height="18" rx="1" fill="#ffffff" /><rect x="9" y="7" width="11" height="4.5" rx="1" fill="#ffffff" /><rect x="9" y="13" width="8.5" height="4.5" rx="1" fill="#ffffff" />';

const logoText =
	'<text x="40" y="22" font-family="inherit" font-size="17" font-weight="600" fill="currentColor">FirstCrop</text>';

const logoSvg = smallLogo
	? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32" aria-label="${site.title}" class="${logoClass}">${logoMark}</svg>`
	: `<svg xmlns="http://www.w3.org/2000/svg" width="140" height="32" viewBox="0 0 140 32" class="${logoClass}">${logoMark}${logoText}</svg>`;
---

{
	header ? (
		<Fragment>
			<Fragment set:html={'<!-- BEGIN NAVBAR LOGO -->'} />
			<div class:list={brandClasses}>
				<a href={href} aria-label={site.title}>{!hideLogo && <Fragment set:html={logoSvg} />}{showTitle && 'Dashboard'}</a>
			</div>
			<Fragment set:html={'<!-- END NAVBAR LOGO -->'} />
		</Fragment>
	) : (
		<Fragment>
			<Fragment set:html={'<!-- BEGIN NAVBAR LOGO -->'} />
			<a
				href={href}
				aria-label={site.title}
				class:list={brandClasses}
				>{!hideLogo && <Fragment set:html={logoSvg} />}{showTitle && 'Dashboard'}</a>
			<Fragment set:html={'<!-- END NAVBAR LOGO -->'} />
		</Fragment>
	)
}
